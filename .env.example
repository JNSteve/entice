NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
# Public origin used when building external share links (QR posters, copied
# URLs) outside a request context. Falls back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# Xero (Settings → Xero). Register the app at developer.xero.com with redirect
# URI ${NEXT_PUBLIC_APP_URL}/api/xero/callback. XERO_TOKEN_KEY is 32 random
# bytes, base64 — mint one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TOKEN_KEY=
